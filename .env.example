# Copy to .env.local / .env.production and fill in values

NEXT_PUBLIC_APP_NAME=fanxy
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_BASE_PATH=

# Admin Panel → App Settings → API Path
NEXT_PUBLIC_API_BASE_URL=https://admin.fanxy.app/api/
API_BASE_URL=https://admin.fanxy.app/api/

# Admin Panel → App Settings → API Token
NEXT_PUBLIC_API_TOKEN=

# Session signing secret
NEXTAUTH_SECRET=

# Optional: Firebase service account JSON string for chat push
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
